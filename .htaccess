# ==========================================
# 1. BẢO MẬT & CHỐNG DUYỆT THƯ MỤC
# ==========================================
# Tắt chế độ hiển thị danh sách file trong thư mục
Options -Indexes

# Chặn truy cập trực tiếp vào các file nhạy cảm, file cache, log, htaccess
<FilesMatch "^\.|\.(env|json|log|lock|cache|sql|bak|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ==========================================
# 2. CẤU HÌNH REWRITE ENGINE & HTTPS
# ==========================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ép chuyển hướng sang HTTPS nếu chưa có (Khuyên dùng cho SSL Cloudflare/InfinityFree)
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ==========================================
    # 3. MAPPING DỊCH 9 ROUTE API SANG SLUG ĐẸP
    # ==========================================
    
    # Route 1: Admin tạo Key (/create)
    RewriteRule ^create/?$ api.php?action=create [L,QSA]

    # Route 2: Client kích hoạt Key (/active)
    RewriteRule ^active/?$ api.php?action=active [L,QSA]

    # Route 3: Admin khóa Key (/revoke)
    RewriteRule ^revoke/?$ api.php?action=revoke [L,QSA]

    # Route 4: Admin tra cứu thông tin Key (/info)
    RewriteRule ^info/?$ api.php?action=info [L,QSA]

    # Route 5: Admin mở khóa IP (/unban)
    RewriteRule ^unban/?$ api.php?action=unban [L,QSA]

    # Route 6: Admin xem danh sách IP bị khóa (/list_banned)
    RewriteRule ^list_banned/?$ api.php?action=list_banned [L,QSA]

    # Route 7: Admin xem danh sách License Key (/list_licenses)
    RewriteRule ^list_licenses/?$ api.php?action=list_licenses [L,QSA]

    # Route 8: Admin Import CSV (/import_csv)
    RewriteRule ^import_csv/?$ api.php?action=import_csv [L,QSA]

    # Route 9: Admin lấy số liệu thống kê tổng quan (/stats)
    RewriteRule ^stats/?$ api.php?action=stats [L,QSA]

</IfModule>

# ==========================================
# 4. BẢO MẬT CẤP HEADER (CORS & SECURITY)
# ==========================================
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>